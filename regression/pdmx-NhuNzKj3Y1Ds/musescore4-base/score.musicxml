    <credit-words default-x="595.44" default-y="1626.67" justify="center" valign="top" font-size="24">Gavotte</credit-words>
    </credit>
  <credit page="1">
    <credit-type>composer</credit-type>
    <credit-words default-x="1134.19" default-y="1469.39" justify="right" valign="bottom">François GOSSEC
</credit-words>
    <credit-words>(1734-1829)</credit-words>
    </credit>
  <credit page="1">
    <credit-type>subtitle</credit-type>
    <credit-words default-x="56.69" default-y="1569.97" justify="left" valign="top" font-size="14">Born a peasant's son in The Netherlands, Gossec became an important figure in the development of French instrumental music. 
</credit-words>
    <credit-words>The spritely leaps in the melody are characteristic of this composer.</credit-words>
    </credit>
